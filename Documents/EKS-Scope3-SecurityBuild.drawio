                </mxCell>
                <mxCell id="iam" value="AWS IAM role: memos_github_role&#xa;assumed via OIDC - no static credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1414;strokeColor=#ED7100;fontColor=#F0A868;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="885" y="196" width="223" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;font style=&quot;font-size: 16px; color: rgb(255, 255, 255);&quot;&gt;Security controls in this pipeline&lt;br&gt;Checkov: Infrastructure-as-Code scanning&lt;br&gt;ECR plus Trivy: container image CVE scanning (Trivy is the gate)&lt;br&gt;OIDC: keyless AWS auth, no stored secrets&lt;br&gt;Hardened image: SHA-pinned, non-root, stripped binary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=2 3;fillColor=#0E0E0E;strokeColor=#555555;fontColor=#DDDDDD;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="1" vertex="1">
