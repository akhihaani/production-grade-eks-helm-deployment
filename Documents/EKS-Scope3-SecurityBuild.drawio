                    <mxGeometry x="40" y="62" width="900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="trig" value="Trigger&#xa;push to app or Dockerfile paths&#xa;(or manual workflow_dispatch)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#14202A;strokeColor=#6C8EBF;fontColor=#B7C4D0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="380" y="98" width="280" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="gha" value="GitHub Actions runner (ubuntu-latest)&#xa;Checkout repo plus submodules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10203A;strokeColor=#2088FF;fontColor=#FFFFFF;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="397.5" y="192" width="245" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="checkov" value="Checkov scan - SECURITY: IaC&#xa;Terraform IaC scan&#xa;(soft-fail: reports, does NOT block)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2210;strokeColor=#E6A23C;fontColor=#FFE7B3;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="296" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="docker" value="docker build plus tag = git SHA&#xa;multi-stage, SHA-pinned base, non-root user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10233A;strokeColor=#2496ED;fontColor=#FFFFFF;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="406" width="280" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="pushimg" value="Push image to Amazon ECR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#241A10;strokeColor=#ED7100;fontColor=#FFFFFF;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="512" width="280" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="ecrscan" value="ECR image scan - SECURITY: image CVE&#xa;AWS-native CVE scan, severity counts&#xa;written to the job summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A2210;strokeColor=#E6A23C;fontColor=#FFE7B3;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="604" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="trivy" value="Trivy scan - SECURITY GATE&#xa;CRITICAL / HIGH, ignore-unfixed&#xa;exit-code 1 = FAILS the build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A1414;strokeColor=#E5484D;fontColor=#FFC9C9;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="380" y="714" width="280" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="bump" value="Bump image tag in git&#xa;sed into helm/memos-chart/values.yaml&#xa;commit plus push (skip ci)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#241A10;strokeColor=#E8873B;fontColor=#FFFFFF;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="380" y="832" width="280" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="handoff" value="To Scope 2b (Runtime)&#xa;ArgoCD detects the new image tag&#xa;and syncs it to the cluster" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#2A1414;strokeColor=#E06666;fontColor=#F2A6A6;fontSize=11;" parent="1" vertex="1">
